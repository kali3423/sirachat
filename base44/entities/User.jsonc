{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string",
      "description": "Custom display name chosen by the user"
    },
    "profile_image": {
      "type": "string",
      "description": "Profile image URL chosen by the user"
    },
    "bio": {
      "type": "string",
      "description": "Short bio shown on the user's profile"
    },
    "points": {
      "type": "number",
      "description": "Study points balance; new users start at 500",
      "default": 500
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}