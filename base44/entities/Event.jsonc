{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "study",
        "exam",
        "meeting",
        "personal"
      ],
      "default": "study"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  }
}